            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.data-grapes.com/agents",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create agent"
        }
      ]
    }
  ],
  "bundled": true
}